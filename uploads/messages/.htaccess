# Message attachments are private: never served directly. account/attachment.php checks that the
# person signed in is the sender or recipient, then sends the file.
Options -Indexes -ExecCGI
Require all denied

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
