# Local secrets (Google OAuth client secret)
config/google.local.php

# Optional GIPHY key for GIF search in Messages (see config/giphy.local.example.php)
config/giphy.local.php

# Email account (Gmail App Password) for sending confirmation links (see config/mail.local.example.php)
config/mail.local.php

# AI model (onboarding): its key and its local model files (see ai/README.md)
ai/config.local.php
ai/models/*
!ai/models/.gitkeep

# Users' uploaded profile photos and message attachments (keep each folder's .htaccess lock-down)
uploads/avatars/*
!uploads/avatars/.htaccess
uploads/messages/*
!uploads/messages/.htaccess
uploads/documents/*
!uploads/documents/.htaccess

# Hosting settings: live database password and site address (see config/db.php)
config/config.local.php

# FTP login for tools/deploy.php (uploads changed files to the live site)
config/deploy.local.php

# Server logs (mail delivery log written by includes/mailer.php)
logs/*
!logs/.htaccess
