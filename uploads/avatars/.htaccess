# Profile photos only (written by account/avatar.php). Nothing in this folder may run as code.
# No "-ExecCGI" here: InfinityFree doesn't allow that option in .htaccess and answers every photo with
# "500 Internal Server Error" (broken profile pictures). Only .jpg/.png/.webp are served (below) anyway.
Options -Indexes

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

# Serve only the image types the upload accepts; refuse everything else.
<FilesMatch "\.(?i:jpg|png|webp)$">
    Require all granted
</FilesMatch>
<FilesMatch "^(?!.*\.(?i:jpg|png|webp)$).*">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; sandbox"
</IfModule>
